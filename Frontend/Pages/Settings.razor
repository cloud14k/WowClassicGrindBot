@page "/Settings"

@inject IconDB iconDB
@inject IJSRuntime JSRuntime
@inject IServiceProvider Services
@inject WowProcessInput wowInput
@inject InputBackendSettings inputSettings
@inject ILogger<Settings> Logger
@implements IDisposable
@using Core.Training
@using Core.Decision
@using Game
@using HidShared

<Card class="mt-2">
    <CardHeader>键鼠输入</CardHeader>
    <CardBody>
        <select class="form-select mb-2" style="width: auto;" @bind="inputBackend">
            <option value="Windows">普通键鼠</option>
            <option value="Hid">ESP32 HID</option>
        </select>
        <div class="small mb-2">当前实际输入：@(wowInput.IsHidBackend ? $"ESP32 HID（{BotHidPort}）" : "普通键鼠")</div>
        @if (InputSelectionPending)
        {
            <div class="text-warning small mb-2">选择尚未保存，bot 仍使用上方显示的实际输入。请点击“保存”使选择生效。</div>
        }
        @if (inputBackend == "Hid")
        {
            <div class="d-flex flex-wrap align-items-end gap-2">
                <label>CDC 串口
                    <select class="form-select" @bind="hidPort">
                        @if (hidPorts.Length == 0)
                        {
                            <option value="@hidPort">@hidPort</option>
                        }
                        @foreach (string port in hidPorts)
                        {
                            <option value="@port">@port</option>
                        }
                    </select>
                </label>
                <button class="btn btn-secondary" @onclick="RefreshHidPorts">刷新 COM</button>
                <span class="badge @(BotHidConnected ? "bg-success" : "bg-secondary") fs-6">
                    Bot COM：@(BotHidConnected ? $"OPEN ({BotHidPort})" : "CLOSED")
                </span>
                <button class="btn btn-outline-primary" @onclick="TestHidAsync" disabled="@(hidTestRunning || !BotHidConnected)">@(hidTestRunning ? "测试中..." : "测试 Bot HID")</button>
            </div>
            <div class="@(BotHidConnected ? "text-success" : "text-muted") small mt-1">
                这里显示的是 bot 实际使用的 CDC 状态；设置页不会另外打开或关闭 COM。
            </div>
            @if (hidTestMessage is not null)
            {
                <div class="@(hidTestSucceeded ? "text-success" : "text-danger") small mt-1">@hidTestMessage</div>
            }
        }
        <div><button class="btn btn-primary mt-2" @onclick="SaveInputBackend">保存</button></div>
        <div class="text-muted small">保存后立即切换输入后端，无需重启程序。HID 模式仅在 WoW 位于前台时发送新输入；切到后台会释放已按键并等待恢复。</div>
        @if (inputError is not null) { <div class="text-danger small">@inputError</div> }
        @if (inputSaveMessage is not null && !InputSelectionPending) { <div class="text-success small">@inputSaveMessage</div> }
    </CardBody>
</Card>

<Card class="mt-2">
    <CardHeader>训练数据采集</CardHeader>
    <CardBody>
        <label class="form-check-label">
            <input type="checkbox" class="form-check-input me-2" @bind="trainingEnabled"
                   @bind:after="OnTrainingChanged" disabled="@(trainingSettings is null)" />
            启用 AI 训练数据采集
        </label>
        @if (trainingError is not null)
        {
            <div class="text-danger small">@trainingError</div>
        }
    </CardBody>
</Card>

<Card class="mt-2">
    <CardHeader>AI 决策</CardHeader>
    <CardBody>
        <div class="d-flex flex-wrap gap-3 align-items-end">
            <label>Decision Mode
                <select class="form-select" @bind="decisionMode">
                    <option value="Local">Local</option>
                    <option value="AI">AI</option>
                </select>
            </label>
            <label>Laya 地址
                <input class="form-control" @bind="layaBaseUrl" />
            </label>
            <label>超时 (ms)
                <input class="form-control" type="number" min="50" max="5000" @bind="layaTimeoutMs" />
            </label>
            <label>最小置信度
                <input class="form-control" type="number" min="0" max="1" step="0.05" @bind="layaMinimumConfidence" />
            </label>
            <label>最小决策间隔 (ms)
                <input class="form-control" type="number" min="100" max="10000" @bind="layaIntervalMs" />
            </label>
        </div>
        <button class="btn btn-primary mt-2" @onclick="SaveDecision" disabled="@(decisionSettings is null)">保存并立即生效</button>
        <div class="mt-2">Decision Mode: @effectiveDecisionSource</div>
        @if (effectiveDecisionSource == "AI" && aiStatus is not null)
        {
            <div class="alert @(aiStatus.Current.Connected ? "alert-success" : "alert-danger") mt-2" role="alert">
                AI Service: @(aiStatus.Current.Connected ? "Connected" : "DISCONNECTED")；
                AI Control: @(aiStatus.Current.Running ? "Running" : "Paused")；
                Current Action: @(aiStatus.Current.CurrentAction?.ToString() ?? "-")；
                Confidence: @(aiStatus.Current.Confidence?.ToString("F2") ?? "-")；
                Latency: @(aiStatus.Current.LatencyMs?.ToString() ?? "-") ms；
                Last Error: @(aiStatus.Current.LastError ?? "-")；
                Last Successful AI Decision: @(aiStatus.Current.LastSuccessfulDecisionTime?.ToLocalTime().ToString("G") ?? "-")
            </div>
        }
        @if (decisionError is not null) { <div class="text-danger small">@decisionError</div> }
    </CardBody>
</Card>

<Card class="mt-2">
    <CardHeader>Icon CDN Region</CardHeader>
    <CardBody>
        <p class="text-muted small">Select the closest CDN for faster icon loading.</p>
        <select class="form-select" style="width: auto;" @bind="selectedRegion" @bind:after="OnRegionChanged">
            <option value="0">Auto-detect</option>
            <option value="1">US (Americas)</option>
            <option value="2">EU (Europe/Africa)</option>
            <option value="3">KR (Korea)</option>
            <option value="4">TW (Taiwan)</option>
        </select>
        @if (detectedRegion != null)
        {
            <small class="text-muted ms-2">Detected: @detectedRegion</small>
        }
    </CardBody>
</Card>

@code {
    private int selectedRegion;
    private string? detectedRegion;
    private TrainingCollectionSettings? trainingSettings;
    private bool trainingEnabled;
    private string? trainingError;
    private DecisionSettings? decisionSettings;
    private AIServiceStatus? aiStatus;
    private string decisionMode = "Local";
    private string layaBaseUrl = "http://127.0.0.1:8000";
    private int layaTimeoutMs = 250;
    private int layaIntervalMs = 300;
    private double layaMinimumConfidence = 0.7;
    private string? decisionError;
    private string effectiveDecisionSource
    {
        get
        {
            DecisionConfiguration? active = decisionSettings?.Current;
            return active?.Mode.ToString() ?? "Local";
        }
    }
    private string inputBackend = "Windows";
    private string hidPort = "COM3";
    private string[] hidPorts = [];
    private bool hidTestRunning;
    private bool hidTestSucceeded;
    private string? hidTestMessage;
    private string? inputError;
    private string? inputSaveMessage;

    private bool InputSelectionPending => inputBackend != inputSettings.Backend ||
        (inputBackend == "Hid" && !string.Equals(hidPort, inputSettings.Port, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        inputBackend = inputSettings.Backend;
        hidPort = inputSettings.Port;
        RefreshHidPorts();
    }

    private bool BotHidConnected => wowInput.IsHidBackend && wowInput.IsHidConnected;
    private string BotHidPort => wowInput.HidPort ?? hidPort;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            trainingSettings = Services.GetService(typeof(TrainingCollectionSettings))
                as TrainingCollectionSettings;
            decisionSettings = Services.GetService(typeof(DecisionSettings)) as DecisionSettings;
            aiStatus = Services.GetService(typeof(AIServiceStatus)) as AIServiceStatus;
            if (aiStatus is not null) aiStatus.Changed += OnAiStatusChanged;
            if (decisionSettings is not null)
            {
                DecisionConfiguration decision = decisionSettings.Current;
                decisionMode = decision.Mode.ToString();
                layaBaseUrl = decision.Laya.BaseUrl;
                layaTimeoutMs = decision.Laya.TimeoutMs;
                layaIntervalMs = decision.Laya.MinimumIntervalMs;
                layaMinimumConfidence = decision.Laya.MinimumConfidence;
            }
            trainingEnabled = trainingSettings?.EnableTrainingDataCollection ?? false;
            selectedRegion = await JSRuntime.InvokeAsync<int>("LocalStorageHelper.getCdnRegion");
            int detected = await JSRuntime.InvokeAsync<int>("LocalStorageHelper.detectCdnRegion");
            detectedRegion = detected switch { 1 => "US", 2 => "EU", 3 => "KR", 4 => "TW", _ => "US" };
            StateHasChanged();
        }
    }

    private async Task OnRegionChanged()
    {
        await JSRuntime.InvokeVoidAsync("LocalStorageHelper.setCdnRegion", selectedRegion);
        int effectiveRegion = selectedRegion == 0
            ? await JSRuntime.InvokeAsync<int>("LocalStorageHelper.detectCdnRegion")
            : selectedRegion;
        iconDB.Region = (CdnRegion)effectiveRegion;
    }

    private void OnTrainingChanged()
    {
        try
        {
            trainingSettings?.SetEnabled(trainingEnabled);
            trainingError = null;
        }
        catch (Exception ex)
        {
            trainingEnabled = trainingSettings?.EnableTrainingDataCollection ?? false;
            trainingError = ex.Message;
        }
    }

    private void SaveDecision()
    {
        try
        {
            DecisionMode mode = Enum.Parse<DecisionMode>(decisionMode, true);
            decisionSettings?.Save(new DecisionConfiguration
            {
                Mode = mode,
                Laya = new LayaSettings
                {
                    BaseUrl = layaBaseUrl,
                    TimeoutMs = layaTimeoutMs,
                    MinimumIntervalMs = layaIntervalMs,
                    MinimumConfidence = layaMinimumConfidence
                }
            });
            decisionError = null;
        }
        catch (Exception ex) { decisionError = ex.Message; }
    }

    private void OnAiStatusChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        if (aiStatus is not null) aiStatus.Changed -= OnAiStatusChanged;
    }

    private void SaveInputBackend()
    {
        inputSaveMessage = null;
        try
        {
            inputSettings.Save(inputBackend, hidPort);
            inputError = null;
            inputSaveMessage = wowInput.IsHidBackend
                ? $"已保存，bot 当前使用 ESP32 HID（{BotHidPort}）。"
                : "已保存，bot 当前使用普通键鼠。";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save input backend {Backend} (port {Port})", inputBackend, hidPort);
            inputError = $"保存失败：{ex.Message}。当前配置仍为 {inputSettings.Backend}。";
        }
    }

    private void RefreshHidPorts()
    {
        try
        {
            hidPorts = HidPortDiscovery.GetPortNames();
            if (hidPorts.Length > 0 && !hidPorts.Contains(hidPort, StringComparer.OrdinalIgnoreCase))
                hidPort = hidPorts[0];
            hidTestMessage = null;
        }
        catch (Exception ex)
        {
            hidPorts = [];
            hidTestSucceeded = false;
            hidTestMessage = $"读取 COM 口失败：{ex.Message}";
        }
    }

    private async Task TestHidAsync()
    {
        if (!BotHidConnected)
        {
            hidTestSucceeded = false;
            hidTestMessage = "Bot 当前没有打开 ESP32 HID 串口，请先保存 HID 后端配置。";
            return;
        }

        hidTestRunning = true;
        hidTestSucceeded = false;
        hidTestMessage = $"正在测试 {BotHidPort}...";
        try
        {
            using CancellationTokenSource timeout = new(TimeSpan.FromSeconds(3));
            byte sequence = await wowInput.ProbeHidAsync(timeout.Token);
            hidTestSucceeded = true;
            hidTestMessage = $"HID 在位：{BotHidPort} 已返回 ACK（序号 {sequence}）。";
        }
        catch (OperationCanceledException)
        {
            hidTestSucceeded = false;
            hidTestMessage = $"HID 测试超时：{BotHidPort} 未返回 ESP32 ACK。请检查设备和固件日志。";
        }
        catch (UnauthorizedAccessException)
        {
            hidTestSucceeded = false;
            hidTestMessage = $"HID 测试失败：{BotHidPort} 的 bot 连接不可用。";
        }
        catch (Exception ex)
        {
            hidTestSucceeded = false;
            hidTestMessage = $"HID 测试失败：{ex.Message}";
        }
        finally { hidTestRunning = false; }
    }

}
