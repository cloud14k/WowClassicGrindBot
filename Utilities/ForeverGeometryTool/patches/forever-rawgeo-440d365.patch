 {
+    void WriteVec3Array(std::ofstream& out, std::vector<float> const& values,
+        std::size_t firstVertex, std::size_t vertexCount)
+    {
+        out << '[';
+        for (std::size_t i = 0; i < vertexCount; ++i)
+        {
+            if (i)
+                out << ',';
+            std::size_t offset = (firstVertex + i) * 3;
+            out << '[' << values[offset] << ',' << values[offset + 1] << ',' << values[offset + 2] << ']';
+        }
+        out << ']';
+    }
+
+    void WriteTriangleArray(std::ofstream& out, std::vector<int> const& indices,
+        std::size_t firstTriangle, std::size_t triangleCount, std::size_t vertexIndexOffset = 0)
+    {
+        out << '[';
+        for (std::size_t i = 0; i < triangleCount; ++i)
+        {
+            if (i)
+                out << ',';
+            std::size_t offset = (firstTriangle + i) * 3;
+            out << '[' << indices[offset] - vertexIndexOffset << ','
+                << indices[offset + 1] - vertexIndexOffset << ','
+                << indices[offset + 2] - vertexIndexOffset << ']';
+        }
+        out << ']';
+    }
+
+    bool WriteRawGeometry(std::filesystem::path const& directory, uint32 mapID,
+        uint32 tileX, uint32 tileY, MMAP::MeshData const& meshData,
+        std::size_t terrainVertexCount, std::size_t terrainTriangleCount)
+    {
+        char const* product = std::getenv("TC_RAW_GEOMETRY_CLIENT_PRODUCT");
+        char const* buildText = std::getenv("TC_RAW_GEOMETRY_CLIENT_BUILD");
+        if (!product || !*product || !buildText || !*buildText)
+            return false;
+
+        for (char const* c = product; *c; ++c)
+            if (!(std::isalnum(static_cast<unsigned char>(*c)) || *c == '_' || *c == '-'))
+                return false;
+
+        errno = 0;
+        char* buildEnd = nullptr;
+        unsigned long long build = std::strtoull(buildText, &buildEnd, 10);
+        if (errno == ERANGE || !buildEnd || *buildEnd != '\0' || build == 0 ||
+            build > std::numeric_limits<uint32>::max())
+            return false;
+
+        std::size_t solidVertexCount = meshData.solidVerts.size() / 3;
+        std::size_t solidTriangleCount = meshData.solidTris.size() / 3;
+        std::size_t liquidVertexCount = meshData.liquidVerts.size() / 3;
+        std::size_t liquidTriangleCount = meshData.liquidTris.size() / 3;
+        if (meshData.solidVerts.size() % 3 || meshData.solidTris.size() % 3 ||
+            meshData.liquidVerts.size() % 3 || meshData.liquidTris.size() % 3 ||
+            meshData.liquidType.size() != liquidTriangleCount ||
+            terrainVertexCount > solidVertexCount || terrainTriangleCount > solidTriangleCount)
+            return false;
+
+        for (int index : meshData.solidTris)
+            if (index < 0 || std::size_t(index) >= solidVertexCount)
+                return false;
+        for (int index : meshData.liquidTris)
+            if (index < 0 || std::size_t(index) >= liquidVertexCount)
+                return false;
+
+        std::error_code ec;
+        std::filesystem::create_directories(directory, ec);
+        if (ec)
+            return false;
+
+        std::filesystem::path path = directory / Trinity::StringFormat(
+            "map{:04}_adt{:02}_{:02}.rawgeo.json", mapID, tileY, tileX);
+        std::ofstream out(path, std::ios::binary | std::ios::trunc);
+        if (!out)
+            return false;
+
+        std::size_t collisionVertexCount = solidVertexCount - terrainVertexCount;
+        std::size_t collisionTriangleCount = solidTriangleCount - terrainTriangleCount;
+        if (collisionTriangleCount != meshData.wmoCollisionTriangles + meshData.m2CollisionTriangles)
+            return false;
+        for (std::size_t i = terrainTriangleCount * 3; i < meshData.solidTris.size(); ++i)
+            if (std::size_t(meshData.solidTris[i]) < terrainVertexCount)
+                return false;
+
+        out << std::setprecision(9);
+        out << "{\"format\":\"wow-raw-geometry-v1\",\"map_id\":" << mapID
+            << ",\"adt_xy\":[" << tileY << ',' << tileX << ']'
+            << ",\"mmap_xy\":[" << tileX << ',' << tileY << ']'
+            << ",\"client_product\":\"" << product << "\",\"client_build\":" << build
+            << ",\"units\":\"yard\",\"coordinates\":\"[WoW_X,WoW_Z,WoW_Y]\""
+            << ",\"target_rc_transform\":\"[raw_Z,raw_Y,raw_X]\""
+            << ",\"terrain_vertex_count\":" << terrainVertexCount
+            << ",\"terrain_triangle_count\":" << terrainTriangleCount
+            << ",\"collision_vertex_count\":" << collisionVertexCount
+            << ",\"collision_triangle_count\":" << collisionTriangleCount
+            << ",\"wmo_triangle_count\":" << meshData.wmoCollisionTriangles
+            << ",\"m2_triangle_count\":" << meshData.m2CollisionTriangles
+            << ",\"liquid_vertex_count\":" << liquidVertexCount
+            << ",\"liquid_triangle_count\":" << liquidTriangleCount
+            << ",\"liquid_type_count\":" << meshData.liquidType.size()
+            << ",\"terrain_vertices\":";
+        WriteVec3Array(out, meshData.solidVerts, 0, terrainVertexCount);
+        out << ",\"terrain_triangles\":";
+        WriteTriangleArray(out, meshData.solidTris, 0, terrainTriangleCount);
+        out << ",\"collision_vertices\":";
+        WriteVec3Array(out, meshData.solidVerts, terrainVertexCount, collisionVertexCount);
+        out << ",\"collision_triangles\":";
+        WriteTriangleArray(out, meshData.solidTris, terrainTriangleCount,
+            collisionTriangleCount, terrainVertexCount);
+        out << ",\"liquid_vertices\":";
+        WriteVec3Array(out, meshData.liquidVerts, 0, liquidVertexCount);
+        out << ",\"liquid_triangles\":";
+        WriteTriangleArray(out, meshData.liquidTris, 0, liquidTriangleCount);
+        out << ",\"liquid_types\":[";
+        for (std::size_t i = 0; i < meshData.liquidType.size(); ++i)
+        {
+            if (i)
+                out << ',';
+            out << unsigned(meshData.liquidType[i]);
+        }
+        out << "]}\n";
+        out.close();
+        return bool(out);
+    }
